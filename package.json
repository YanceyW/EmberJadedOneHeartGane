{
  "name": "xiuxian-wangdu",
  "version": "0.1.0",
  "private": true,
  "description": "休闲王都 - 微信小游戏合集",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node tools/postinstall.mjs",
    "gen:manifest": "node tools/gen-manifest.mjs",
    "clean": "node tools/clean.mjs",
    "build": "npm run gen:manifest && npm run clean && tsc -p tsconfig.json && node tools/copy-assets.mjs && node tools/gen-game-json.mjs && node tools/check-size.mjs",
    "dev": "npm run gen:manifest && tsc -p tsconfig.json --watch",
    "typecheck": "npm run gen:manifest && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "smoke": "node tools/smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke",
    "size": "node tools/check-size.mjs",
    "validate:content": "node tools/validate-content.mjs",
    "new:game": "node tools/new-game.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
